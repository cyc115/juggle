#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12,<3.14"
# dependencies = []
# ///
"""juggle-agent-monitor — streams agent completions to stdout for Monitor tool.

Each line printed is one completed agent: [LABEL] role: title
Role is 'researcher' when a review action item exists; 'coder' otherwise.

Thin argv→main() wrapper; all polling logic lives in src/juggle_monitor_daemon.py.

``--once`` is the cron fallback for machines where the Monitor tool is
unavailable (telemetry disabled): a single poll against the SAME per-session
cursor as the streaming daemon, then exit — see juggle_monitor_daemon.run_once.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "src"))

from juggle_monitor_daemon import main, run_once

if __name__ == "__main__":
    if "--once" in sys.argv[1:]:
        run_once()
    else:
        main()
